{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Issuer": "http://localhost:8080/auth/realms/vtshop",
    "MetadataAddress": "http://keycloak:8080/auth/realms/vtshop/.well-known/openid-configuration",
    "Audience": "vtshop-api",
    "RequireHttpsMetadata": false
  },
  "RateLimiting": {
    "Api": { "PermitLimit": 100, "WindowSeconds": 10 },
    "Auth": { "PermitLimit": 300, "WindowSeconds": 60 }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-read": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**rest}", "Methods": [ "GET" ] },
        "RateLimiterPolicy": "api",
        "CorsPolicy": "storefront"
      },
      "catalog-write": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**rest}", "Methods": [ "POST", "PUT", "DELETE" ] },
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "api",
        "CorsPolicy": "storefront"
      },
      "keycloak": {
        "ClusterId": "keycloak",
        "Match": { "Path": "/auth/{**rest}" },
        "RateLimiterPolicy": "auth",
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "storefront": {
        "ClusterId": "storefront",
        "Order": 1000,
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": { "catalog": { "Address": "http://catalog:8080/" } }
      },
      "keycloak": {
        "Destinations": { "keycloak": { "Address": "http://keycloak:8080/" } }
      },
      "storefront": {
        "Destinations": { "storefront": { "Address": "http://frontend:80/" } }
      }
    }
  }
}
